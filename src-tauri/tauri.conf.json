{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Italian Learning Development",
  "version": "0.1.0",
  "identifier": "io.github.misc9115-boop.lang",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Italian learning · Development",
        "width": 1180,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["nsis", "dmg"],
    "macOS": { "minimumSystemVersion": "12.0" }
  }
}
